{
  "name": "hisar-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "ሕሳር — Amharic AI (desktop)",
  "author": "ZebraCodeX",
  "license": "Unlicense",
  "homepage": "https://github.com/ZebraCodeX/amharic-nlp-chatbot",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zebracodex.hisar",
    "productName": "Hisar",
    "copyright": "Copyright © 2026 ZebraCodeX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      { "from": "../frontend/dist", "to": "web" }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Hisar-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.education",
      "artifactName": "Hisar.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Zer uses the microphone for live Amharic/English voice conversation.",
        "NSSpeechRecognitionUsageDescription": "Zer uses speech recognition for the \u201cHey Zer\u201d wake word."
      }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "maintainer": "ZebraCodeX",
      "artifactName": "Hisar.${ext}"
    },
    "publish": [
      { "provider": "github", "owner": "ZebraCodeX", "repo": "amharic-nlp-chatbot" }
    ]
  }
}
